# Copy to /etc/blackmemon-leads/env and fill in. Never commit the real file.
LEADS_SECRET_KEY=change-me-to-a-long-random-value-at-least-16-chars
DATABASE_URL=postgres://leads_app:CHANGE@127.0.0.1:5432/leads
LEADS_WORKER_DATABASE_URL=postgres://leads_worker:CHANGE@127.0.0.1:5432/leads
LEADS_LISTEN=127.0.0.1:8000
LEADS_BASE_URL=https://leads.example.com
LEADS_COOKIE_SECURE=true
LEADS_TRUST_PROXY=true
LEADS_DIST=/opt/blackmemon-leads/dist
# Optional absolute path when `claude` is not on the gateway user's PATH.
# CLAUDE_CLI=/usr/local/bin/claude
